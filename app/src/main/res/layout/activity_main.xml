<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <dev.wallpaperart.ArtView
        android:id="@+id/artView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/art_preview" />

    <!-- Shuffle actions on the left; save and the matching locks on the right. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnShuffleBoth"
                style="@style/ActionButton"
                android:drawableStart="@drawable/ic_shuffle"
                android:text="@string/btn_shuffle_both" />

            <Button
                android:id="@+id/btnShufflePattern"
                style="@style/ActionButton"
                android:layout_marginTop="8dp"
                android:drawableStart="@drawable/ic_shuffle"
                android:text="@string/btn_pattern" />

            <Button
                android:id="@+id/btnShuffleColours"
                style="@style/ActionButton"
                android:layout_marginTop="8dp"
                android:drawableStart="@drawable/ic_shuffle"
                android:text="@string/btn_colours" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="2"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnSave"
                style="@style/ActionButton"
                android:drawableStart="@drawable/ic_save"
                android:text="@string/btn_save" />

            <CheckBox
                android:id="@+id/lockPattern"
                style="@style/LockToggle"
                android:layout_marginTop="8dp"
                android:text="@string/btn_pattern" />

            <CheckBox
                android:id="@+id/lockColours"
                style="@style/LockToggle"
                android:layout_marginTop="8dp"
                android:text="@string/btn_colours" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/savedLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/saved_label"
        android:textColor="@color/text_dim"
        android:textSize="13sp"
        android:visibility="gone" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/savedRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnHide"
            style="@style/QuietButton"
            android:layout_marginEnd="6dp"
            android:text="@string/btn_hide" />

        <Button
            android:id="@+id/btnPatterns"
            style="@style/QuietButton"
            android:layout_marginEnd="6dp"
            android:text="@string/btn_patterns" />

        <Button
            android:id="@+id/btnShare"
            style="@style/QuietButton"
            android:layout_marginEnd="6dp"
            android:text="@string/btn_share" />

        <Button
            android:id="@+id/btnAuto"
            style="@style/QuietButton"
            android:layout_marginEnd="6dp"
            android:text="@string/btn_auto" />

        <Button
            android:id="@+id/btnWallpaper"
            style="@style/QuietButton"
            android:text="@string/btn_wallpaper" />
    </LinearLayout>
</LinearLayout>
