<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="8dp">

    <Switch
        android:id="@+id/switchWallpaper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/wallpaper_switch"
        android:textColor="@color/text"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/solidLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/text_dim"
        android:textSize="13sp" />

    <SeekBar
        android:id="@+id/solidSeek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:max="60" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/divide_label"
        android:textColor="@color/text_dim"
        android:textSize="13sp" />

    <RadioGroup
        android:id="@+id/divideGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/divideRandom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/divide_random"
            android:textColor="@color/text"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/divideLine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/divide_line"
            android:textColor="@color/text"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/divideArc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/divide_arc"
            android:textColor="@color/text"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/divideFade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/divide_fade"
            android:textColor="@color/text"
            android:textSize="13sp" />
    </RadioGroup>
</LinearLayout>
